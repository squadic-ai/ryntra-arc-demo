# Ryntra Guard for Arc — server-only prototype configuration.
# Never prefix these values with NEXT_PUBLIC_. Never commit real credentials.
CIRCLE_APP_KIT_KEY=replace-with-server-side-circle-app-kit-key
RYNTRA_GUARD_DEMO_API_KEY=replace-with-random-tenant-scoped-api-key
RYNTRA_GUARD_DEMO_TENANT_ID=replace-with-demo-tenant-id

# --- Arc Testnet RPC ------------------------------------------------------
# Server-side reads (preflight evidence and, critically, post-broadcast
# reconciliation) go through this endpoint. It defaults to the official
# https://rpc.testnet.arc.io.
#
# That endpoint sits behind a WAF that refuses whole networks — a blocked region
# gets Cloudflare error 1009. When that happens the browser can still sign and
# broadcast while the server cannot read chain state, which leaves a real
# transaction stuck at RECONCILIATION_REQUIRED. Point this at an HTTPS endpoint
# the server can actually reach. A malformed or non-HTTPS value is a startup
# error, never a silent fallback.
# Arc publishes one primary host and three provider mirrors. Verified 2026-08-07
# from a Ukrainian IP: the primary returns Cloudflare error 1009, all three
# mirrors return chain id 0x4cef52 normally.
#   https://rpc.testnet.arc.io                 (primary)
#   https://rpc.blockdaemon.testnet.arc.io
#   https://rpc.drpc.testnet.arc.io
#   https://rpc.quicknode.testnet.arc.io
# ARC_TESTNET_RPC_URL=https://rpc.blockdaemon.testnet.arc.io
#
# The browser sends its own RPC calls from the user's network, so the wallet
# network definition needs the same treatment. This one is public by design.
# NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.blockdaemon.testnet.arc.io

# --- Lifecycle persistence -----------------------------------------------
# The Guard lifecycle (intent, evaluation, authorization, idempotency request
# hash, execution, transaction dedupe, reconciliation, receipt) lives in the
# store selected here.
#
#   memory    per-process, lost on cold start. Fine for tests and a local demo.
#   file      JSON files under RYNTRA_GUARD_STORE_DIR. Survives cold start, but
#             it is safe for ONE writer only.
#   postgres  any Postgres reachable over DATABASE_URL. Survives cold start and
#             concurrent instances — the only option a multi-instance
#             deployment accepts.
#
# Naming a durable store without its configuration is a startup error on
# purpose: a silent downgrade to something weaker is exactly the failure this
# configuration prevents.
RYNTRA_GUARD_STORE=memory
# RYNTRA_GUARD_STORE_DIR=.guard-store

# --- Multi-writer store ---------------------------------------------------
# Required by RYNTRA_GUARD_STORE=postgres. Any Postgres works: a managed
# database from a platform marketplace, Neon, Supabase, or one you run. The
# adapter creates its own table on first use and needs no migration step.
#
# TLS is verified against the system trust store. This connection carries the
# authorization and settlement record, so an unverified peer would let anyone on
# the path read and rewrite the evidence the system exists to preserve.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# How many instances serve this process's traffic. Defaults to multi-instance on
# a managed platform (VERCEL set) and single-instance locally.
#
# On a multi-instance deployment a store that is not multi-writer safe refuses
# every state-changing request with CAPABILITY_UNAVAILABLE and requiredAction
# CONFIGURE_DURABLE_MULTI_WRITER_GUARD_STORE. Read /health to see the
# persistence, deployment shape, and whether state changes are accepted.
# RYNTRA_GUARD_DEPLOYMENT=single-instance
